__pycache__/
*.py[cod]
*.pyd
*.so
# 例外：`dcg/_accel` 的预编译加速后端必须入库才能随 wheel 发布（双活可用的前提）
!dcg/_accel/*.pyd
!dcg/_accel/*.so
.pytest_cache/
/gen/
.pyxbld/
*.c
*.lib
*.exp
*.obj

# v1 旧实现存档：只作对照参考，不属于 v2.2 交付物
V1/

# 本地探查/临时脚本与临时目录（Lead 分析用，不入库）
_tmp/
.tmp*/
# 验收/审计过程产物：_tmp_head_verify 是 HEAD 隔离快照，不属于交付物
_tmp_head_verify/
# 半成品生成器试验目录（tmp_* 前缀一律是本机试验，不入库）
tmp_semi/

# 探针脚本（审计/对拍时临时写的）
evidence/_*.py

# Cython 编译中间产物（evidence/bench_cython.py 生成，约 5.5 MB，不入库）
build/

# pytest 原始日志目录（每次跑都覆盖，不入库）
evidence/pytest_runs/

# 改代码时的临时备份（*.bak 一律不入库）
*.bak

# 打包留存（`git archive` 产出的源码包 + 校验和，按需重新生成）
dist/

# `python -m pip wheel .` 的元数据中间产物，按需重新生成
*.egg-info/

# pytest 的临时根目录：被删后会在仓库根留下空目录，随系统权限残留，不入库
pytest-cache-files-*/
